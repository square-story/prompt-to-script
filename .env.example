# API
PORT=4000
NODE_ENV=development

# LLM integration mode: "mock" (no external calls) or "real"
LLM_MODE=mock

# AI Services (required when LLM_MODE=real)
ANTHROPIC_API_KEY=your_key_here
PERPLEXITY_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# (Optional for existing v2 codepaths in this repo)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPERMEMORY_API_KEY=
REDIS_URL=redis://localhost:6379
JWT_SECRET=
SERPAPI_KEY=
YOUTUBE_API_KEY=
NEWSAPI_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supermemory
SUPERMEMORY_API_KEY=

# Perplexity
PERPLEXITY_API_KEY=

# Claude (Anthropic)
ANTHROPIC_API_KEY=

# OpenAI (Moderation API only)
OPENAI_API_KEY=

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Platform APIs (Topic Discovery)
SERPAPI_KEY=
YOUTUBE_API_KEY=
NEWSAPI_KEY=

# App
PORT=4000
NODE_ENV=development
JWT_SECRET=
